    "model":  {
                  "sectionTitle":  "Method",
                  "sectionTag":  "BENCHMARK DESIGN",
                  "sectionSubtitle":  "Scene reconstruction, visual refinement, and explicit route-conditioned planning are evaluated together.",
                  "stages":  [
                                 {
                                     "number":  "01",
                                     "title":  "Reconstruct continuous scenes",
                                     "description":  "OmniRe builds a 3D Gaussian Splatting scene for each 100-second sequence, initialized from LiDAR and optimized from eight surround-view cameras."
                                 },
                                 {
                                     "number":  "02",
                                     "title":  "Refine novel views",
                                     "description":  "A fine-tuned Fixer diffusion model refines rendered camera images at ego poses that differ from the recorded trajectory; the underlying scene and simulated state remain unchanged."
                                 },
                                 {
                                     "number":  "03",
                                     "title":  "Condition planners on routes",
                                     "description":  "Planners receive a sequence of 120 SD-map points sampled one meter apart. They must interpret road-level topology and translate it into scene-consistent lane maneuvers."
                                 }
                             ]
